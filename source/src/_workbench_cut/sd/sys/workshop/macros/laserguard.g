; laserguard.g -- GUARD of the low power jobs generated by
; WorkshopJog (e.g. "Frame with the laser"). It is the FIRST line of those
; jobs: if anything is not right it aborts and the whole job is cancelled
; before the laser turns on.
;
; Use:  M98 P"0:/sys/workshop/macros/laserguard.g" S4      (S = power in % it is going to use)
;
; CAREFUL: do NOT use P for the power -- in M98, P is the file name and
; param.P never reaches the macro (real bug 2026-10-08: the guard
; always aborted with "power missing").
;
; 10 W diode laser (M452 R255 -> S0..S255). Limits agreed with the
; user 2026-10-08: 4 % by default, warning in the UI above
; 3 %, HARD CAP 10 % (this file). Change the cap ONLY here and in the UI
; (TJ_LASER_FRAME_MAX_PCT in 15-cutarea.js) and only if the user asks for it.

var en = exists(global.workshopLanguage) ? (global.workshopLanguage == "en") : false   ; messages in English (DWC language, see sys/workshop/macros/language.g)
var modo = exists(global.selectedMode) ? global.selectedMode : state.machineMode   ; machine mode (global.selectedMode if it exists; otherwise the RRF one)
var maxPct = 10

if !exists(param.S)
    abort {var.en ? ("Laser: power missing (S%)") : ("Laser: falta la potencia (S%)")}
if param.S < 0 || param.S > var.maxPct
    var tmsg1 = "Laser: potencia " ^ param.S ^ "% fuera de lo permitido (0 a " ^ var.maxPct ^ "%). No se encendio el laser."
    if var.en
        set var.tmsg1 = "Laser: power " ^ param.S ^ "% outside the allowed range (0 to " ^ var.maxPct ^ "%). The laser was not turned on."
    abort {var.tmsg1}
if var.modo != "Laser"
    abort {var.en ? ("Laser: the machine is not in Laser mode. The laser was not turned on.") : ("Laser: la maquina no esta en modo Laser. No se encendio el laser.")}
if state.machineMode != "Laser"
    abort {var.en ? ("Laser: the firmware is not in laser mode (M452). The laser was not turned on.") : ("Laser: el firmware no esta en modo laser (M452). No se encendio el laser.")}
if !move.axes[0].homed || !move.axes[1].homed
    abort {var.en ? ("Laser: home X and Y first.") : ("Laser: primero hace homing de X e Y.")}
