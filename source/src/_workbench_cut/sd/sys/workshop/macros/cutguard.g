; cutguard.g -- GUARD of the CUT jobs generated by WorkshopJog
; (Zones page -> "Simple cuts" layout). It is the FIRST line of those
; jobs: if anything is not right it aborts and the whole job is cancelled
; before the laser is turned on (the abort of a macro called from a job
; cancels the job: checked live 2026-10-08).
;
; Use:  M98 P"0:/sys/workshop/macros/cutguard.g" S80      (S = MAXIMUM power of the job, in %)
; (S and not P: in M98 the P is the file name.)
;
; Unlike sys/workshop/macros/laserguard.g (framing, 10 % cap), here the cap is
; 100 %: cutting needs real power. What is checked is that the machine
; is ready: real Laser mode (M452) and X/Y homed.

var en = exists(global.workshopLanguage) ? (global.workshopLanguage == "en") : false   ; messages in English (DWC language, see sys/workshop/macros/language.g)
var modo = exists(global.selectedMode) ? global.selectedMode : state.machineMode   ; machine mode (global.selectedMode if it exists; otherwise the RRF one)
if !exists(param.S)
    abort {var.en ? ("Cut: power missing (S%)") : ("Corte: falta la potencia (S%)")}
if param.S <= 0 || param.S > 100
    abort {var.en ? ("Cut: power " ^ param.S ^ "% out of range (1 to 100%). The laser was not turned on.") : ("Corte: potencia " ^ param.S ^ "% fuera de rango (1 a 100%). No se encendio el laser.")}
if var.modo != "Laser"
    abort {var.en ? ("Cut: the machine is not in Laser mode. The laser was not turned on.") : ("Corte: la maquina no esta en modo Laser. No se encendio el laser.")}
if state.machineMode != "Laser"
    abort {var.en ? ("Cut: the firmware is not in laser mode (M452). The laser was not turned on.") : ("Corte: el firmware no esta en modo laser (M452). No se encendio el laser.")}
if !move.axes[0].homed || !move.axes[1].homed
    abort {var.en ? ("Cut: home X and Y first.") : ("Corte: primero hace homing de X e Y.")}
