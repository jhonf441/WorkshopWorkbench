; cncguard.g -- GUARD of the CNC jobs generated by the Workbench
; (Zones page -> "CNC toolpaths" card). It is the FIRST code line of those
; jobs: if anything is not right it aborts and the whole job is cancelled
; before the spindle is started (the abort of a macro called from a job
; cancels the job: checked live 2026-10-08 with cutguard.g).
;
; Use:  M98 P"0:/sys/workshop/macros/cncguard.g" D6 H5
;       D = deepest pass of the job below Z0 (mm, positive)   H = safe height above Z0 (mm)
; (never P for a value: in M98 the P is the file name.)
;
; The same pattern as sys/workshop/macros/cutguard.g (laser): what is checked
; is that the machine is ready: real CNC mode (M453), X/Y/Z homed, the Z0 of
; the active work system set on the material (its offset is not 0) and, with
; D / H, that the job fits in the Z travel at that Z0.

var en = exists(global.workshopLanguage) ? (global.workshopLanguage == "en") : false   ; messages in English (DWC language, see sys/workshop/macros/language.g)
var modo = exists(global.selectedMode) ? global.selectedMode : state.machineMode   ; machine mode (global.selectedMode if it exists; otherwise the RRF one)
if var.modo != "CNC"
    abort {var.en ? ("CNC: the machine is not in CNC mode. The spindle was not started.") : ("CNC: la maquina no esta en modo CNC. No se encendio el husillo.")}
if state.machineMode != "CNC"
    abort {var.en ? ("CNC: the firmware is not in CNC mode (M453). The spindle was not started.") : ("CNC: el firmware no esta en modo CNC (M453). No se encendio el husillo.")}
if !move.axes[0].homed || !move.axes[1].homed || !move.axes[2].homed
    abort {var.en ? ("CNC: home X, Y and Z first.") : ("CNC: primero hace homing de X, Y y Z.")}
var z0 = move.axes[2].workplaceOffsets[move.workplaceNumber]   ; Z0 of the active work system, in machine mm
if var.z0 == 0
    abort {var.en ? ("CNC: set the Z zero on the material first (Z0 here).") : ("CNC: primero fija el cero de Z sobre el material (Z0 aqui).")}
var below = var.z0 - move.axes[2].min   ; mm of travel below Z0
var above = move.axes[2].max - var.z0   ; mm of travel above Z0
if exists(param.D) && param.D > var.below
    abort {var.en ? ("CNC: depth " ^ param.D ^ " mm does not fit below this Z0 (" ^ var.below ^ " mm of travel).") : ("CNC: la profundidad " ^ param.D ^ " mm no cabe bajo este Z0 (" ^ var.below ^ " mm de recorrido).")}
if exists(param.H) && param.H > var.above
    abort {var.en ? ("CNC: safe height " ^ param.H ^ " mm is above the Z top at this Z0 (" ^ var.above ^ " mm left).") : ("CNC: la altura segura " ^ param.H ^ " mm supera el tope de Z con este Z0 (" ^ var.above ^ " mm libres).")}
